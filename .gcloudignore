# Cloud Run --source upload filter (takes precedence over .gitignore).
# Must keep src/**/data (e.g. src/literacy/data/sentinelSources.ts).
.git
.github
.cursor
node_modules/
dist/
build/
coverage/
.env
.env.*
!.env.example
*.log
.DS_Store
.vscode/
.idea/
android/
ios/
/data/
/data/**
secrets/
*-firebase-adminsdk-*.json
*.pem
build-local.txt
tsc-out.txt
*.tsbuildinfo

# Explicit keep — never drop literacy / app data modules
!src/
!src/**/
!src/**/data/
!src/**/data/**
!src/literacy/
!src/literacy/data/
!src/literacy/data/**
