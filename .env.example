# =============================================================================
# ClearPath Trader — server-side secrets
# Copy to `.env`. NEVER prefix secrets with VITE_ (those can ship to the browser).
# The app boots without secrets; missing keys degrade features gracefully.
# =============================================================================

# --- Core AI / market data (server only) ---
GEMINI_API_KEY=
GROQ_API_KEY=
TWELVEDATA_API_KEY=

# Macro / fundamentals proxies (server only — never accept from the browser)
FRED_API_KEY=
FMP_API_KEY=

# News / market sockets
NEWSDATA_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=
BENZINGA_API_KEY=

# Session signing — REQUIRED in production (min 32 random chars).
# Signs the httpOnly `cpt.sid` cookie. Without it, sessions reset on every restart.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Optional: comma-separated browser origins allowed to call the API cross-origin in production.
# Leave empty for same-origin only (recommended when the SPA is served by this server).
# CORS_ALLOWED_ORIGINS=https://www.example.com,https://app.example.com

# Registration pipeline (waitlist + identity pre-registration)
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ClearPath Trader <noreply@clearpathtrader.com>
ADMIN_NOTIFY_EMAIL=

# Board / Founders portal access code — verified SERVER-SIDE only (min 6 chars).
# Prefer BOARD_ACCESS_CODE (not VITE_). No default; blank disables board login.
BOARD_ACCESS_CODE=
# Legacy alias (still read by the server if BOARD_ACCESS_CODE is unset):
VITE_BOARD_ACCESS_CODE=
# Recipient inbox for abuse / law-enforcement reports sent from the app
VITE_ABUSE_REPORT_EMAIL=abuse@clearpathtrader.com

# Cloud SQL PostgreSQL
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Podcast Index (server-side only)
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# CrewAI / Make.com intelligence webhook (required in production)
INTELLIGENCE_WEBHOOK_SECRET=
MAKE_WEBHOOK_URL=

# Admin secret for deleting public River catalog entries
CATALOG_ADMIN_SECRET=

# IndexNow (Bing / Yandex / Naver ecosystem URL ping). Optional — if unset, uses
# SESSION_SECRET/CATALOG_ADMIN_SECRET derive, else public default
# clearpath-trader-indexnow-01 (file also in /public). Use a-z A-Z 0-9 and '-' only.
# Hosted at https://clearpathtrader.com/{INDEXNOW_KEY}.txt
INDEXNOW_KEY=

# Optional ops / messaging (health probes only unless wired elsewhere)
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
STRIPE_SECRET_KEY=

# Appwrite Cloud — Soft Launch Waitlist (public project IDs only; never put API secrets here)
VITE_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=clearpath
VITE_APPWRITE_WAITLIST_TABLE_ID=waitlist

# Firebase web client config (public identifiers). Restrict the key by HTTP referrer in Google Cloud Console.
# Do not commit live keys into firebase-applet-config.json ? set them here instead.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# =============================================================================
# App / APK auto-update (consent-first ? never silent install)
# Client compares VITE_* build stamps to GET /api/app-update.
# =============================================================================
# Web build stamp (also used as the "current" version in the SPA)
VITE_APP_VERSION=1.0.0
# Keep in sync with android/app/build.gradle versionCode / versionName
VITE_ANDROID_VERSION_CODE=1
VITE_ANDROID_VERSION_NAME=1.0

# Server publishes "latest" ? bump these when you ship
APP_UPDATE_WEB_VERSION=1.0.0
APP_UPDATE_WEB_MIN_VERSION=1.0.0
APP_UPDATE_WEB_NOTES=Refresh for the latest ClearPath Trader web build.
APP_UPDATE_ANDROID_VERSION_NAME=1.0
APP_UPDATE_ANDROID_VERSION_CODE=1
APP_UPDATE_ANDROID_MIN_VERSION_CODE=1
APP_UPDATE_ANDROID_NOTES=A newer ClearPath Android build is available.
APP_UPDATE_DEFAULT_SEVERITY=soft
APP_UPDATE_SNOOZE_HOURS=24

# Preferred Android update path (HTTPS Play Store / listing URL)
APP_UPDATE_PLAY_STORE_URL=

# Optional APK sideload (OFF by default). Requires ALL of:
#   APP_UPDATE_ALLOW_APK=true, HTTPS URL on allowlisted host, and sha256 hex.
APP_UPDATE_ALLOW_APK=false
APP_UPDATE_APK_URL=
APP_UPDATE_APK_SHA256=
# APP_UPDATE_APK_HOST_ALLOWLIST=github.com,objects.githubusercontent.com,storage.googleapis.com
