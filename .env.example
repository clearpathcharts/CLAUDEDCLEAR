# =============================================================================
# ClearPath Trader — server-side secrets
# Copy to `.env`. NEVER prefix secrets with VITE_ (those can ship to the browser).
# App boots without secrets; missing keys degrade features gracefully.
# Local ↔ Cloud Run parity checklist: docs/venture-env-parity.md
# =============================================================================

# --- Core AI / market data (server only) ---
GEMINI_API_KEY=
GROQ_API_KEY=
# Preferred name. Also accepts TWELVE_DATA_API_KEY (Cloud Run spelling).
# If both are set and differ, the longer value is tried first, then the other
# (a stale duplicate is why the live site 401s while local .env works).
# After changing Cloud Run env: Deploy and keep traffic on LATEST.
TWELVEDATA_API_KEY=

# Macro / fundamentals proxies (server only — never accept from the browser)
FRED_API_KEY=
# Financial Modeling Prep: use FMP_API_KEY (canonical). FINANCIAL_MODELING_PREP_API_KEY is an alias only.
FMP_API_KEY=

# News / market sockets
NEWSDATA_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=
BENZINGA_API_KEY=

# Session signing — REQUIRED in production (min 32 random chars).
# Signs the httpOnly `cpt.sid` cookie. Without it, sessions reset on every restart.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Daily swap-hour timeframe accuracy sweep (server scheduler).
# Runs once/day in [HOUR:00, HOUR:59] of TIMEFRAME_VERIFY_TZ. Default 02:00–02:59 America/New_York.
TIMEFRAME_VERIFY_ENABLED=1
TIMEFRAME_VERIFY_HOUR=2
TIMEFRAME_VERIFY_TZ=America/New_York
# Optional comma list (defaults to deck-critical majors). Example: EURUSD,XAUUSD,BTCUSD
# TIMEFRAME_VERIFY_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD,BTCUSD,AAPL,SPX,DXY

# Hourly Site Doctor — detect+report to CEO Dashboard (does not auto-rewrite code)
SITE_DOCTOR_ENABLED=1
# SITE_DOCTOR_INTERVAL_MS=3600000

# Daily structure briefing (CEO inbox) — Sun–Fri ET schedule, Firestore, CEO publish gate.
DAILY_PATTERN_REVIEW_ENABLED=1
# NYSE regular-session close (default 16 = 4:00 PM ET) and overnight refresh (default 1 = 1:00 AM ET)
# DAILY_PATTERN_REVIEW_CLOSE_HOUR_ET=16
# DAILY_PATTERN_REVIEW_OVERNIGHT_HOUR_ET=1
# Founder newsletter inbox (defaults to forexanarchy@gmail.com) — sent only after CEO publishes
# DAILY_PATTERN_REVIEW_EMAIL=
# DAILY_PATTERN_REVIEW_EMAIL_ENABLED=1
# Market Prophets daily brief (read-only wire into CEO inbox + digest)
MARKET_PROPHETS_URL=https://marketprophets.io
# MARKET_PROPHETS_TIMEOUT_MS=8000
#
# Daily briefing product tiers (free media + $5.99/mo pattern literacy training) live in
# src/lib/dailyBriefingProducts.ts — no Stripe env vars required until checkout is wired.

# Optional: comma-separated browser origins allowed to call the API cross-origin in production.
# Leave empty for same-origin only (recommended when the SPA is served by this server).
# CORS_ALLOWED_ORIGINS=https://www.example.com,https://app.example.com

# Firebase Admin (server). On Cloud Run, prefer the runtime service account + ADC
# (K_SERVICE set) — leave FIREBASE_SERVICE_ACCOUNT empty unless you must inject JSON.
# Optional JSON string of a service-account key (local/dev or non-GCP hosts only):
FIREBASE_SERVICE_ACCOUNT=
# Or path to a key file:
GOOGLE_APPLICATION_CREDENTIALS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ClearPath Trader <noreply@clearpathtrader.com>
ADMIN_NOTIFY_EMAIL=

# Board / Founders portal access code — verified SERVER-SIDE only (min 6 chars).
# Prefer BOARD_ACCESS_CODE (not VITE_). No default; blank disables board login.
BOARD_ACCESS_CODE=
# Legacy alias (still read by the server if BOARD_ACCESS_CODE is unset):
VITE_BOARD_ACCESS_CODE=
# Recipient inbox for abuse / law-enforcement reports sent from the app
VITE_ABUSE_REPORT_EMAIL=abuse@clearpathtrader.com

# Cloud SQL PostgreSQL
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Podcast Index (server-side only)
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# CrewAI / Make.com intelligence webhook (required in production)
INTELLIGENCE_WEBHOOK_SECRET=
MAKE_WEBHOOK_URL=

# ClearPath Social OS — OWN DOMAIN (disconnected from clearpathtrader.com)
# Run: npm run dev:social-os | Docker: Dockerfile.social-os
# DIRECT publisher — no Buffer / Zapier / Make / Hootsuite
SOCIAL_OS_PUBLIC_URL=
# VITE_SOCIAL_OS_PUBLIC_URL=   # optional link on clearpathtrader.com “moved” page
SOCIAL_OS_BRAND_SITE_URL=https://clearpathtrader.com
SOCIAL_OS_PORT=3010
# SOCIAL_OS_PLATFORMS=all  → full catalog (social + networking)
SOCIAL_OS_TIMEZONE=America/New_York
SOCIAL_OS_POST_SLOTS=05:00,09:00,15:00,18:00
SOCIAL_OS_PLATFORMS=facebook,instagram,x,linkedin,youtube,tiktok,reddit,discord,telegram,bluesky,threads
SOCIAL_OS_AUTO_TEMPLATE=1
# SOCIAL_OS_DRY_RUN=1
# SOCIAL_OS_SCHEDULER=1
# SOCIAL_OS_TICK_MS=60000
# SOCIAL_OS_SLOT_WINDOW_MINUTES=10

# Optional ClearPath-owned outbound webhook (YOUR endpoint — not a SaaS scheduler)
# SOCIAL_DIRECT_WEBHOOK_URL=
# SOCIAL_WEBHOOK_SECRET=
# Per-platform: SOCIAL_WEBHOOK_FACEBOOK= SOCIAL_WEBHOOK_XING= …

# Direct API credentials (add only for networks you connect)
# SOCIAL_FACEBOOK_PAGE_ACCESS_TOKEN=
# SOCIAL_FACEBOOK_PAGE_ID=
# SOCIAL_INSTAGRAM_ACCESS_TOKEN=
# SOCIAL_INSTAGRAM_BUSINESS_ACCOUNT_ID=
# SOCIAL_X_BEARER_TOKEN=
# SOCIAL_LINKEDIN_ACCESS_TOKEN=
# SOCIAL_LINKEDIN_AUTHOR_URN=
# SOCIAL_THREADS_ACCESS_TOKEN=
# SOCIAL_THREADS_USER_ID=
# SOCIAL_TELEGRAM_BOT_TOKEN=
# SOCIAL_TELEGRAM_CHAT_ID=
# SOCIAL_DISCORD_WEBHOOK_URL=
# SOCIAL_BLUESKY_HANDLE=
# SOCIAL_BLUESKY_APP_PASSWORD=
# SOCIAL_REDDIT_CLIENT_ID=
# SOCIAL_REDDIT_CLIENT_SECRET=
# SOCIAL_REDDIT_USERNAME=
# SOCIAL_REDDIT_PASSWORD=
# SOCIAL_REDDIT_SUBREDDIT=
# SOCIAL_PINTEREST_ACCESS_TOKEN=
# SOCIAL_PINTEREST_BOARD_ID=
# SOCIAL_WHATSAPP_TOKEN=
# SOCIAL_WHATSAPP_PHONE_NUMBER_ID=
# SOCIAL_WHATSAPP_TO=
# SOCIAL_TIKTOK_ACCESS_TOKEN=
# SOCIAL_YOUTUBE_ACCESS_TOKEN=
# SOCIAL_SNAPCHAT_ACCESS_TOKEN=
# SOCIAL_TWITCH_ACCESS_TOKEN=

# Admin secret for deleting public River catalog entries
CATALOG_ADMIN_SECRET=

# Optional: Firebase Auth uid for forexanarchy@gmail.com. When set, Bearer founder
# unlock must match this uid (not email alone). Private Login founder session still uses email.
# FOUNDER_FIREBASE_UID=

# IndexNow (Bing / Yandex / Naver ecosystem URL ping). Optional — if unset, uses
# SESSION_SECRET/CATALOG_ADMIN_SECRET derive, else public default
# clearpath-trader-indexnow-01 (file also in /public). Use a-z A-Z 0-9 and '-' only.
# Hosted at https://clearpathtrader.com/{INDEXNOW_KEY}.txt
INDEXNOW_KEY=

# Optional ops / messaging. Chart pulses (5/10/15/30m email or SMS) need
# SMTP_* (email) and/or Twilio (text). Health probes still work without them.
# Ava voice receptionist is not shipped yet — TWILIO_* is optional until then.
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender for chart-pulse SMS, e.g. +15551234567
TWILIO_FROM=

# Optional: GitHub PAT for Daily Ops Actions monitoring (private repo).
# Needs actions:read on clearpathcharts/CLAUDEDCLEAR. Without it the check
# skips cleanly instead of painting WARN on the CEO desk.
# GITHUB_TOKEN=
# GITHUB_REPO=clearpathcharts/CLAUDEDCLEAR

# --- Stripe membership billing (server only — never VITE_) ---
# Prefer a restricted key (rk_...) with Checkout Sessions + Customers + Subscriptions
# write access over a full secret key (sk_...).
STRIPE_SECRET_KEY=
# Signing secret for POST /api/stripe/webhook (whsec_...). Get it from
# Stripe Dashboard → Developers → Webhooks, or `stripe listen` locally.
# Subscribe the endpoint to: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=
# Optional Dashboard Price IDs (price_...). When unset, checkout uses inline
# price_data with the built-in amounts (existing Stripe ladder — not the public feature catalog):
#   Pro $9.95/mo ($95.40/yr) · Pro+ $19.95/mo ($191.40/yr)
#   Premium $30.95/mo ($311.40/yr) · Ultimate $69.95/mo ($779.40/yr)
# Silver / Gold / Platinum Price IDs are aliases onto that ladder until a new one is chosen.
# Every checkout starts a 15-day free trial (plus the 15-day Platinum launch gift).
STRIPE_PRICE_SILVER_MONTHLY=
STRIPE_PRICE_SILVER_YEARLY=
STRIPE_PRICE_GOLD_MONTHLY=
STRIPE_PRICE_GOLD_YEARLY=
STRIPE_PRICE_PLATINUM_MONTHLY=
STRIPE_PRICE_PLATINUM_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PROPLUS_MONTHLY=
STRIPE_PRICE_PROPLUS_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_ULTIMATE_MONTHLY=
STRIPE_PRICE_ULTIMATE_YEARLY=

# Appwrite Cloud — Soft Launch Waitlist (public project IDs only; never put API secrets here)
VITE_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=clearpath
VITE_APPWRITE_WAITLIST_TABLE_ID=waitlist

# Firebase web client config (public identifiers). Restrict the key by HTTP referrer in Google Cloud Console.
# Do not commit live keys into firebase-applet-config.json ? set them here instead.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# =============================================================================
# App / APK auto-update (consent-first ? never silent install)
# Client compares VITE_* build stamps to GET /api/app-update.
# =============================================================================
# Web build stamp (also used as the "current" version in the SPA)
VITE_APP_VERSION=1.0.0
# Keep in sync with android/app/build.gradle versionCode / versionName
VITE_ANDROID_VERSION_CODE=1
VITE_ANDROID_VERSION_NAME=1.0

# Server publishes "latest" ? bump these when you ship
APP_UPDATE_WEB_VERSION=1.0.0
APP_UPDATE_WEB_MIN_VERSION=1.0.0
APP_UPDATE_WEB_NOTES=Refresh for the latest ClearPath Trader web build.
APP_UPDATE_ANDROID_VERSION_NAME=1.0
APP_UPDATE_ANDROID_VERSION_CODE=1
APP_UPDATE_ANDROID_MIN_VERSION_CODE=1
APP_UPDATE_ANDROID_NOTES=A newer ClearPath Android build is available.
APP_UPDATE_DEFAULT_SEVERITY=soft
APP_UPDATE_SNOOZE_HOURS=24

# Preferred Android update path (HTTPS Play Store / listing URL)
APP_UPDATE_PLAY_STORE_URL=

# Optional APK sideload (OFF by default). Requires ALL of:
#   APP_UPDATE_ALLOW_APK=true, HTTPS URL on allowlisted host, and sha256 hex.
APP_UPDATE_ALLOW_APK=false
APP_UPDATE_APK_URL=
APP_UPDATE_APK_SHA256=
# APP_UPDATE_APK_HOST_ALLOWLIST=github.com,objects.githubusercontent.com,storage.googleapis.com
