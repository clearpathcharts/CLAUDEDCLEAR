# ---------------------------------------------------------------------------
# ClearPath Growth OS — environment
# Copy to .env and fill in. Nothing here is required to run the smoke test,
# but an LLM key is required to actually kick off the crews.
# ---------------------------------------------------------------------------

# LLM provider for the agents. Defaults to Gemini using the GEMINI_API_KEY you
# already have (see AGENTS.md) — no OpenAI key required.
GEMINI_API_KEY=
# Optional overrides / alternative providers:
# OPENAI_API_KEY=
# GROQ_API_KEY=
# Force a specific model (provider/model). Default: gemini/gemini-2.0-flash.
GROWTH_OS_MODEL=

# Base URL of the running ClearPath Trader server (server.ts).
# Local dev default is http://localhost:3000. Production: https://clearpathtrader.com
CLEARPATH_API_BASE=http://localhost:3000

# Where content batches are written (produce) and read (publish).
GROWTH_OS_OUTPUT_DIR=./output

# Compliance gate. When true, batches are produced but never auto-published;
# a human must approve (growth-os-approve) before growth-os-publish will post.
FORCE_HUMAN_REVIEW=true

# ---------------------------------------------------------------------------
# Publishing (the "hands"). Default is a safe dry-run that posts nothing.
# ---------------------------------------------------------------------------
# Provider: dryrun (default) | ayrshare
POSTING_PROVIDER=dryrun
# Only needed when POSTING_PROVIDER=ayrshare (one API key posts to X/LinkedIn/...).
AYRSHARE_API_KEY=

# Optional: real per-country waitlist counts enable the compliant scarcity line.
# JSON file like {"Brazil": 10782, "United States": 4120}
GROWTH_OS_WAITLIST_COUNTS=
