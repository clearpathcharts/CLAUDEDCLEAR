# ---------------------------------------------------------------------------
# ClearPath Growth OS — environment
# Copy to .env and fill in. Nothing here is required to run the smoke test,
# but an LLM key is required to actually kick off the crews.
# ---------------------------------------------------------------------------

# LLM provider for the agents. CrewAI reads OPENAI_API_KEY by default.
# You can point at any provider CrewAI supports (OpenAI, Gemini, Groq, etc.).
OPENAI_API_KEY=
# Optional: override the model. Cheap+fast models are fine for drafting.
MODEL=gpt-4o-mini

# Base URL of the running ClearPath Trader server (server.ts).
# Local dev default is http://localhost:3000. Production: https://clearpathtrader.com
CLEARPATH_API_BASE=http://localhost:3000

# Where approved content batches are written for hand-off to Zapier / schedulers.
GROWTH_OS_OUTPUT_DIR=./output

# Compliance gate. When true, the flow refuses to mark content "approved"
# automatically and always routes to human review (recommended for the first
# 30-day trust window described in the growth strategy).
FORCE_HUMAN_REVIEW=true
