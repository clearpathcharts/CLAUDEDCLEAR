# LLM (pick one primary)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Research tools (required for competitive intel)
SERPER_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
APIFY_API_KEY=

# Optional deeper search
EXA_API_KEY=

# YouTube comment harvesting (optional)
YOUTUBE_API_KEY=

# Apify actor overrides (optional — defaults work for Reddit + app reviews)
APIFY_REDDIT_ACTOR_ID=trudax/reddit-scraper-lite
APIFY_APP_REVIEWS_ACTOR_ID=agents/appstore-reviews-scraper

# ClearPath server bridge
CLEARPATH_API_BASE=https://clearpathtrader.com

# Webhook auth — must match INTELLIGENCE_WEBHOOK_SECRET on ClearPath server
INTELLIGENCE_WEBHOOK_SECRET=

# Kickoff defaults (override per run via main.py inputs)
DEFAULT_ALTERNATIVE_PLATFORM=clearpathtrader.com
DEFAULT_NEURO_PROFILE=calm_focus
DEFAULT_PUBLISH_MODE=draft_only

# Make.com callback (optional)
MAKE_WEBHOOK_URL=
