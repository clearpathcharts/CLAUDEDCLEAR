    "react-helmet-async": "^3.0.0",
    "react-is": "^19.2.7",
    "react-konva": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-player": "^3.4.0",
    "recharts": "^3.8.1",
    "rss-parser": "^3.13.0",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "three": "^0.184.0",
