{
  "name": "clear-path-markets-science",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "river:lex-test": "tsx src/river/pine/lexer.selftest.ts",
    "river:parse-test": "tsx src/river/pine/parser.selftest.ts",
    "river:rir-test": "tsx src/river/rir/rir.selftest.ts",
    "river:runtime-test": "tsx src/river/runtime/runtime.selftest.ts",
    "patterns:scan-test": "tsx src/patterns/scan.selftest.ts",
    "patterns:forming-test": "tsx src/patterns/forming.selftest.ts",
    "river:compile-test": "npm run river:lex-test && npm run river:parse-test && npm run river:rir-test && npm run river:runtime-test && npm run patterns:scan-test && npm run patterns:forming-test",
    "cpms:seed": "tsx scripts/seed-cpms-firestore.ts",
    "cpms:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
