{
  "name": "clear-path-markets-science",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "keep-alive": "bash scripts/keep-alive.sh",
    "pr:auto-update": "bash scripts/pr-auto-updater.sh",
    "pr:auto-update:merge": "bash scripts/pr-auto-updater.sh --merge-ready",
    "pr:auto-update:dry": "bash scripts/pr-auto-updater.sh --dry-run",
    "test:app-update": "tsx scripts/app-update.selftest.ts",
    "test:firebase-mock": "tsx scripts/firebase-mock.selftest.ts",
    "test:homepage-h1": "tsx scripts/homepage-h1.selftest.ts",
    "test:regional-hubs": "tsx scripts/regional-hubs.selftest.ts",
    "test:affiliate": "tsx scripts/affiliate.selftest.ts",
    "test:admin-members": "tsx scripts/admin-members.selftest.ts",
    "test:social-os": "tsx scripts/social-os.selftest.ts",
    "lint": "tsc --noEmit",
    "audit:crawl": "node scripts/crawl-audit.mjs",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "generate:indicator-svgs": "node scripts/generate-indicator-svgs.mjs",
    "test:river": "tsx scripts/riverSelfTest.ts",
    "river:seed-public": "tsx scripts/seed-river-public-catalog.ts",
    "page:auto-update": "tsx scripts/pageAutoUpdater.ts",
    "river:lex-test": "tsx src/river/pine-legacy/lexer.selftest.ts",
    "river:parse-test": "tsx src/river/pine-legacy/parser.selftest.ts",
    "river:rir-test": "tsx src/river/rir/rir.selftest.ts",
    "river:runtime-test": "tsx src/river/runtime/runtime.selftest.ts",
    "patterns:scan-test": "tsx src/patterns/scan.selftest.ts",
    "patterns:forming-test": "tsx src/patterns/forming.selftest.ts",
    "patterns:engine-test": "tsx src/patterns/engine.selftest.ts",
    "river:compile-test": "npm run river:lex-test && npm run river:parse-test && npm run river:rir-test && npm run river:runtime-test && npm run patterns:scan-test && npm run patterns:forming-test && npm run patterns:engine-test",
    "audit:feed": "tsx scripts/audit-feed-accuracy.mjs",
    "audit:symbols": "tsx scripts/audit-symbol-format.mjs",
    "verify:timeframes": "tsx scripts/verify-timeframe-accuracy.mjs",
    "smoke:venture70": "tsx scripts/smoke-venture70.mjs",
    "cpms:seed": "tsx scripts/seed-cpms-firestore.ts",
    "cpms:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
