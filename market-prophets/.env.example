# Required for live brief generation
GEMINI_API_KEY=

# Protect POST /api/brief/generate (Cloud Scheduler sends this header)
BRIEF_CRON_SECRET=change-me-to-a-long-random-string

# Optional: run internal cron at 6:00 AM US/Eastern (in addition to Cloud Scheduler)
BRIEF_INTERNAL_CRON=true

# Public site URL for SEO / sitemap (no trailing slash)
SITE_URL=https://marketprophets.io

PORT=3001
