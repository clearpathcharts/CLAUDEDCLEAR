rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isFounder() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == "forexanarchy@gmail.com";
    }
    function stringField(field, minLen, maxLen) {
      return field is string
        && field.size() >= minLen
        && field.size() <= maxLen;
    }

    // User profile + private subcollections
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isFounder();

      match /analysis_entries/{entryId} {
        allow read, write: if isOwner(userId);
      }
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }
      match /alerts/{alertId} {
        allow read, write: if isOwner(userId);
      }
      match /portfolio/{positionId} {
        allow read, write: if isOwner(userId);
      }
      match /buddy_memory/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /synced_forms/{formId} {
        allow read, write: if isOwner(userId);
        match /responses/{responseId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // Biography / ProfileHub documents (avatar, cover, bio, socials)
    match /profiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /socials/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Social feed — matches backendService createPost/postAnalysis (uid field)
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn()
                            && resource.data.uid == request.auth.uid;
    }

    // Contact / secure messages — create only; server/admin reads via Admin SDK
    match /messages/{messageId} {
      allow create: if isSignedIn()
                    && request.resource.data.senderUid == request.auth.uid
                    && stringField(request.resource.data.name, 1, 200)
                    && stringField(request.resource.data.email, 3, 320)
                    && stringField(request.resource.data.message, 1, 5000);
      allow read, update, delete: if isFounder();
    }

    // Roles are Admin SDK only (prevent client privilege escalation)
    match /roles/{userId} {
      allow read: if isOwner(userId) || isFounder();
      allow write: if false;
    }

    match /engagement/{docId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && stringField(request.resource.data.asset, 1, 100)
                    && stringField(request.resource.data.action, 1, 100);
      allow read: if isSignedIn()
                  && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /strategies/{strategyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && stringField(request.resource.data.name, 1, 200);
      allow update, delete: if isSignedIn()
                            && resource.data.uid == request.auth.uid;
    }

    match /globe_country_configs/{configId} {
      allow read: if true;
      allow write: if isFounder();
    }

    match /cpms_videos/{videoId} {
      allow read: if true;
      allow write: if isFounder();
    }

    match /cpms_channels/{channelId} {
      allow read: if true;
      allow write: if isFounder();
    }

    // Legacy client waitlist fallback (prefer Appwrite /api/registrations/waitlist)
    match /site_registrations/{registrationId} {
      allow create: if stringField(request.resource.data.firstName, 1, 200)
                    && stringField(request.resource.data.emailAddress, 3, 320)
                    && request.resource.data.emailAddress.matches('.+@.+\\..+');
      allow read, update, delete: if false;
    }

    match /identity_preregistrations/{registrationId} {
      allow read, write: if false;
    }

    match /communities_waitlist/{communityId} {
      allow create: if stringField(request.resource.data.name, 1, 200);
      allow read, update, delete: if false;
    }

    match /connected_calendars/{docId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn()
                                  && resource.data.userId == request.auth.uid;
    }

    match /calendar_events/{docId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn()
                                  && resource.data.userId == request.auth.uid;
    }

    // Ops collections — founder only from client; prefer Admin SDK
    match /system_logs/{logId} {
      allow read, write: if isFounder();
    }
    match /api_health_logs/{logId} {
      allow read, write: if isFounder();
    }
  }
}
