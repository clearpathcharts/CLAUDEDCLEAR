# ClearPath Publisher — copy to .env locally, or set on Cloud Run.
# NEVER commit real passwords or bot tokens.

# ── Team accounts (Brent / Dustin / Brian / owner) ───────────────────
# Option A — one line:
# TEAM_USERS=brent:CHANGE_ME:member,dustin:CHANGE_ME:member,brian:CHANGE_ME:member,owner:CHANGE_ME:owner
TEAM_USERS=
# Option B — separate vars:
TEAM_BRENT_PASSWORD=
TEAM_DUSTIN_PASSWORD=
TEAM_BRIAN_PASSWORD=
TEAM_OWNER_PASSWORD=
# Session signing (required)
SESSION_SECRET=
# Optional legacy single password maps to owner if TEAM_OWNER_PASSWORD empty
APP_PASSWORD=

# ── Telegram (direct Bot API) ─────────────────────────────────────────
# Set on Cloud Run only. If a token was pasted in chat, revoke it in BotFather and make a new one.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@clearpathofficalbot

# ── Discord ──────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ── Reddit ───────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=ClearMarketScience

# ── YouTube (optional — ClearPath file upload works without it) ──────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=unlisted

# ── ClearPath-hosted media (upload MP4s here — no YouTube required) ──
# Cloud Run HTTP request limit is ~32MB; default max upload is 28MB.
MEDIA_MAX_MB=28
# Absolute URL of this console (for shareable /media links in packages)
PUBLIC_BASE_URL=
# Optional: persist uploads across Cloud Run revisions (bucket in same GCP project)
GCS_MEDIA_BUCKET=
# Optional public base if objects are publicly readable (else uses storage.googleapis.com/BUCKET)
GCS_PUBLIC_BASE=

PORT=8787
HOST=0.0.0.0
