# ClearPath Publisher — copy to .env locally, or set on Cloud Run.
# NEVER commit real passwords or bot tokens.

# ── Founder login (single owner) ─────────────────────────────────────
# TEAM_USERS=owner:CHANGE_ME:owner
TEAM_USERS=
TEAM_OWNER_PASSWORD=
SESSION_SECRET=
APP_PASSWORD=

# ── Closed-circuit (community, not paid acquisition) ─────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@clearpathofficalbot
DISCORD_WEBHOOK_URL=

# ── Reddit ───────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=ClearMarketScience

# ── MONEY: YouTube (fastest — code ready) ────────────────────────────
# Enable YouTube Data API v3 → OAuth client → refresh token (youtube.upload)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=unlisted

# ── MONEY: Facebook + Instagram (Meta Graph — App Review for prod) ───
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# ── MONEY: TikTok (Content Posting API audit) ────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
# SELF_ONLY until audit allows PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# Optional: force PULL_FROM_URL (needs verified domain on TikTok portal)
TIKTOK_USE_PULL_URL=false

# ── LinkedIn (still bridge — partnership often required) ─────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# ── ClearPath-hosted media ───────────────────────────────────────────
MEDIA_MAX_MB=28
PUBLIC_BASE_URL=https://fuckweasel.net
GCS_MEDIA_BUCKET=
GCS_PUBLIC_BASE=

PORT=8787
HOST=0.0.0.0
